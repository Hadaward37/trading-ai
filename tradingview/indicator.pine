// ══════════════════════════════════════════════════════════════════════════════
//  Trading AI — Oscillator Dashboard  (Pine Script v5)
//
//  Versão apenas-indicadores (sem execução de ordens).
//  Use junto ao gráfico de preço para ver todos os sinais.
//
//  Painel único (overlay=false) com:
//    • RSI (roxo)           — linha 0-100
//    • Estocástico %K (azul) — linha 0-100
//    • ADX (laranja)        — linha 0-100
//    • Score de força (barras verde/vermelho) — 0-100 (mapeado de 0-5)
//    • Background verde/vermelho nas barras com sinal ativo
//    • Shapes ▲▼ nos sinais
//
//  Instale como "Indicador" separado (não como Strategy).
// ══════════════════════════════════════════════════════════════════════════════

//@version=5
indicator(
    title     = "Trading AI — Oscillator Dashboard",
    shorttitle = "TradingAI_OSC",
    overlay   = false,
    max_labels_count = 500
)

// ── Inputs ────────────────────────────────────────────────────────────────────

var GRP_RSI = "RSI"
rsi_len  = input.int(14, "Período",  group=GRP_RSI)
rsi_buy  = input.int(35, "Compra <", group=GRP_RSI, minval=10, maxval=50)
rsi_sell = input.int(75, "Venda >",  group=GRP_RSI, minval=51, maxval=90)

var GRP_MACD = "MACD"
macd_fast = input.int(12, "Rápida", group=GRP_MACD)
macd_slow = input.int(26, "Lenta",  group=GRP_MACD)
macd_sign = input.int(9,  "Sinal",  group=GRP_MACD)

var GRP_BB = "Bollinger Bands"
bb_len = input.int(20,    "Período", group=GRP_BB)
bb_dev = input.float(2.0, "Desvio",  group=GRP_BB)
bb_tol = input.float(0.002, "Tolerância", group=GRP_BB, step=0.001)

var GRP_ADX = "ADX"
adx_len    = input.int(14, "Período",   group=GRP_ADX)
adx_thresh = input.int(25, "Threshold", group=GRP_ADX)

var GRP_STOCH = "Estocástico"
stoch_k_len = input.int(14, "Período K",  group=GRP_STOCH)
stoch_d_len = input.int(3,  "Smooth K",   group=GRP_STOCH)
stoch_sm    = input.int(3,  "Smooth D",   group=GRP_STOCH)
stoch_ob    = input.int(75, "Overbought", group=GRP_STOCH)
stoch_os    = input.int(25, "Oversold",   group=GRP_STOCH)

// ── Cálculo dos indicadores ───────────────────────────────────────────────────

rsi_val = ta.rsi(close, rsi_len)

[macd_line, macd_sig_line, _macd_hist] = ta.macd(close, macd_fast, macd_slow, macd_sign)
macd_cross_up = ta.crossover(macd_line,  macd_sig_line)
macd_cross_dn = ta.crossunder(macd_line, macd_sig_line)

[bb_upper, _bb_mid, bb_lower] = ta.bb(close, bb_len, bb_dev)

[_di_plus, _di_minus, adx_val] = ta.dmi(adx_len, adx_len)

stoch_raw = ta.stoch(close, high, low, stoch_k_len)
stoch_k   = ta.sma(stoch_raw, stoch_d_len)
stoch_d   = ta.sma(stoch_k,   stoch_sm)

// ── Votos ─────────────────────────────────────────────────────────────────────

v_rsi_buy   = rsi_val < rsi_buy   ? 1 : 0
v_rsi_sell  = rsi_val > rsi_sell  ? 1 : 0
v_macd_buy  = macd_cross_up       ? 1 : 0
v_macd_sell = macd_cross_dn       ? 1 : 0
v_bb_buy    = close <= bb_lower * (1 + bb_tol) ? 1 : 0
v_bb_sell   = close >= bb_upper * (1 - bb_tol) ? 1 : 0

buy_votes  = v_rsi_buy  + v_macd_buy  + v_bb_buy
sell_votes = v_rsi_sell + v_macd_sell + v_bb_sell

adx_ok     = adx_val >= adx_thresh
stoch_ok_b = stoch_k  <  stoch_os
stoch_ok_s = stoch_k  >  stoch_ob

buy_signal  = buy_votes  >= 2 and adx_ok and stoch_ok_b
sell_signal = sell_votes >= 2 and adx_ok and stoch_ok_s

// ── Score 0-100 (mapeado de 0-5 condições) ────────────────────────────────────

buy_score  = buy_votes  + (adx_ok ? 1 : 0) + (stoch_ok_b ? 1 : 0)   // 0-5
sell_score = sell_votes + (adx_ok ? 1 : 0) + (stoch_ok_s ? 1 : 0)   // 0-5

// Mapeado para 0-100 para fácil leitura
buy_score_100  = buy_score  * 20
sell_score_100 = sell_score * 20

// ── Plots — Osciladores (escala 0-100) ────────────────────────────────────────

// Linhas de referência
hline(rsi_sell, "RSI Venda",   linestyle=hline.style_dashed, color=color.new(color.red,   30), linewidth=1)
hline(rsi_buy,  "RSI Compra",  linestyle=hline.style_dashed, color=color.new(color.green, 30), linewidth=1)
hline(stoch_ob, "Stoch OB",    linestyle=hline.style_dotted, color=color.new(color.red,   50), linewidth=1)
hline(stoch_os, "Stoch OS",    linestyle=hline.style_dotted, color=color.new(color.green, 50), linewidth=1)
hline(adx_thresh,"ADX Thresh", linestyle=hline.style_dotted, color=color.new(color.orange,40), linewidth=1)
hline(50,       "Mid",         linestyle=hline.style_solid,  color=color.new(color.gray,  60), linewidth=1)
hline(0,        "",            linestyle=hline.style_solid,  color=color.new(color.gray,  40))
hline(100,      "",            linestyle=hline.style_solid,  color=color.new(color.gray,  40))

// RSI
plot(rsi_val, "RSI",
    color     = rsi_val < rsi_buy ? color.new(color.green, 20) :
                rsi_val > rsi_sell ? color.new(color.red, 20)  : color.new(color.purple, 0),
    linewidth = 2)

// Estocástico %K e %D
plot(stoch_k, "Stoch %K",
    color     = stoch_k < stoch_os ? color.new(color.green, 30) :
                stoch_k > stoch_ob ? color.new(color.red, 30)   : color.new(color.blue, 20),
    linewidth = 2)
plot(stoch_d, "Stoch %D", color=color.new(color.orange, 40), linewidth=1)

// ADX
plot(adx_val, "ADX",
    color     = adx_val >= adx_thresh ? color.new(color.orange, 10) : color.new(color.orange, 60),
    linewidth = 1,
    style     = plot.style_line)

// ── Score como barras ─────────────────────────────────────────────────────────

// Barra positiva (BUY score), negativa (SELL score invertido para baixo)
score_bar = buy_signal  ? buy_score_100  :
            sell_signal ? -sell_score_100 : 0

score_col = score_bar > 0 ? color.new(color.green, 40) :
            score_bar < 0 ? color.new(color.red,   40) : color.new(color.gray, 70)

plot(score_bar, "Score", color=score_col, linewidth=3, style=plot.style_histogram)

// ── Background ────────────────────────────────────────────────────────────────

bgcolor(buy_signal  ? color.new(color.green, 88) : na, title="BUY background")
bgcolor(sell_signal ? color.new(color.red,   88) : na, title="SELL background")

// ── Shapes nos sinais ─────────────────────────────────────────────────────────

plotshape(buy_signal,  "BUY",  shape.triangleup,   location.bottom,
    color.new(color.green, 0), size=size.small)
plotshape(sell_signal, "SELL", shape.triangledown, location.top,
    color.new(color.red, 0),   size=size.small)

// ── Labels de score ───────────────────────────────────────────────────────────

if buy_signal
    label.new(bar_index, 5,
        "BUY\n" + str.tostring(buy_score) + "/5",
        color     = color.new(color.green, 20),
        textcolor = color.white,
        style     = label.style_label_up,
        size      = size.tiny)

if sell_signal
    label.new(bar_index, 95,
        "SELL\n" + str.tostring(sell_score) + "/5",
        color     = color.new(color.red, 20),
        textcolor = color.white,
        style     = label.style_label_down,
        size      = size.tiny)

// ── Dashboard de status (tabela) ──────────────────────────────────────────────

var table dash = table.new(
    position.top_right, 3, 7,
    bgcolor      = color.new(color.black, 20),
    border_color = color.new(color.gray, 50),
    border_width = 1
)

bool_icon(v) => v ? "✓" : "✗"
bool_col(v)  => v ? color.green : color.red

if barstate.islast
    table.cell(dash, 0, 0, "Condição",  text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 0, "Valor",     text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 2, 0, "BUY / SELL",text_color=color.gray, text_size=size.tiny)

    // RSI
    table.cell(dash, 0, 1, "RSI", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 1, str.tostring(math.round(rsi_val, 1)), text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 2, 1,
        bool_icon(v_rsi_buy == 1) + " / " + bool_icon(v_rsi_sell == 1),
        text_color=color.silver, text_size=size.tiny)

    // MACD
    table.cell(dash, 0, 2, "MACD xover", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 2,
        macd_line > macd_sig_line ? "Alta" : "Baixa",
        text_color = macd_line > macd_sig_line ? color.green : color.red,
        text_size  = size.tiny)
    table.cell(dash, 2, 2,
        bool_icon(v_macd_buy == 1) + " / " + bool_icon(v_macd_sell == 1),
        text_color=color.silver, text_size=size.tiny)

    // BB
    table.cell(dash, 0, 3, "BB Toque", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 3,
        close < bb_lower ? "Inferior" : close > bb_upper ? "Superior" : "Meio",
        text_color = close < bb_lower ? color.green : close > bb_upper ? color.red : color.gray,
        text_size  = size.tiny)
    table.cell(dash, 2, 3,
        bool_icon(v_bb_buy == 1) + " / " + bool_icon(v_bb_sell == 1),
        text_color=color.silver, text_size=size.tiny)

    // ADX
    table.cell(dash, 0, 4, "ADX ≥ " + str.tostring(adx_thresh), text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 4, str.tostring(math.round(adx_val, 1)), text_color=bool_col(adx_ok), text_size=size.tiny)
    table.cell(dash, 2, 4, bool_icon(adx_ok) + " / " + bool_icon(adx_ok),
        text_color=bool_col(adx_ok), text_size=size.tiny)

    // Stoch
    table.cell(dash, 0, 5, "Stoch %K", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 5, str.tostring(math.round(stoch_k, 1)), text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 2, 5,
        bool_icon(stoch_ok_b) + " / " + bool_icon(stoch_ok_s),
        text_color = stoch_ok_b ? color.green : stoch_ok_s ? color.red : color.gray,
        text_size  = size.tiny)

    // Sinal final
    sig_text = buy_signal ? "🟢 BUY" : sell_signal ? "🔴 SELL" : "⚪ HOLD"
    sig_col  = buy_signal ? color.green : sell_signal ? color.red : color.gray
    table.cell(dash, 0, 6, "SINAL",     text_color=color.white,  text_size=size.tiny)
    table.cell(dash, 1, 6, sig_text,    text_color=sig_col,      text_size=size.tiny)
    cur_s = buy_signal ? buy_score : sell_signal ? sell_score : 0
    table.cell(dash, 2, 6, str.tostring(cur_s) + "/5",
        text_color = cur_s >= 4 ? color.green : cur_s >= 2 ? color.yellow : color.gray,
        text_size  = size.tiny)

// ── Alertas ───────────────────────────────────────────────────────────────────

alertcondition(buy_signal,
    "Trading AI — BUY",
    "BUY | {{ticker}} | Score: " + str.tostring(buy_score) + "/5 | RSI: " + str.tostring(math.round(rsi_val, 1)))

alertcondition(sell_signal,
    "Trading AI — SELL",
    "SELL | {{ticker}} | Score: " + str.tostring(sell_score) + "/5 | RSI: " + str.tostring(math.round(rsi_val, 1)))

alertcondition(buy_signal or sell_signal,
    "Trading AI — Qualquer Sinal",
    "Sinal em {{ticker}} | {{time}}")
